{
	// 必要なシークレット（`wrangler secret put <名前>` で設定する）:
	//   CLERK_SECRET_KEY
	//   CLERK_PUBLISHABLE_KEY
	//
	// 値は Cloudflare 側にしか無いため、ここに宣言は書けない。新しい環境
	// （プレビュー、別アカウント、CI）を立てたときの取りこぼしを防ぐために
	// 名前だけ残している。ローカル開発では `.dev.vars` に置く。
	//
	// 未設定でも公開エンドポイント（`/`, `/health`, `GET /issues`）は動く。
	// 認証が必要な書き込み系だけが 401 になり、`console.error` がログに出る
	// （src/middleware/clerk.ts）。
	"name": "world-issue-tracker-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-01",
	// エラー詳細はレスポンスに載せずログにだけ残す方針（routes/health.ts 参照）。
	// 例外ハンドラ（src/index.ts の app.onError）が console.error で残すログも同様。
	// Observability が無効だとこれらはどこにも保存されず、`wrangler tail` を
	// 張っている間しか見えないため、500 の原因を事後に調べられない。
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "world-issue-tracker",
			"database_id": "546b760c-e10c-45cf-8c40-f3ec508e82fa"
		}
	],
	// Issue に添付する写真の置き場（#65）。
	//
	// バケットは `wrangler r2 bucket create world-issue-tracker-photos` で
	// 作成済み。画像の実体はここに置き、D1 の行にはキーだけを持つ
	// （理由は `migrations/0007_add_photo.sql`）。
	//
	// 公開バケットにはしていない。R2 のカスタムドメインを当てれば
	// 画像を直接配信できるが、そうすると Worker を通らない経路ができ、
	// 通報による非公開化（#65 の範囲外）を後から入れる余地が無くなる。
	// 配信は `GET /issues/:id/photo` が仲介する。
	//
	// `preview_bucket_name` は置いていない。`wrangler dev` / テストは
	// ローカルのシミュレーション（miniflare）で完結し、実バケットを触らない。
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "world-issue-tracker-photos"
		}
	]
}
