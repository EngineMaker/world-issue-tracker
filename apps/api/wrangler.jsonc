{
	// 必要なシークレット（`wrangler secret put <名前>` で設定する）:
	//   CLERK_SECRET_KEY
	//   CLERK_PUBLISHABLE_KEY
	//
	// 値は Cloudflare 側にしか無いため、ここに宣言は書けない。新しい環境
	// （プレビュー、別アカウント、CI）を立てたときの取りこぼしを防ぐために
	// 名前だけ残している。ローカル開発では `.dev.vars` に置く。
	//
	// 未設定でも公開エンドポイント（`/`, `/health`, `GET /issues`）は動く。
	// 認証が必要な書き込み系だけが 401 になり、`console.error` がログに出る
	// （src/middleware/clerk.ts）。
	"name": "world-issue-tracker-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-01",
	// エラー詳細はレスポンスに載せずログにだけ残す方針（routes/health.ts 参照）。
	// 例外ハンドラ（src/index.ts の app.onError）が console.error で残すログも同様。
	// Observability が無効だとこれらはどこにも保存されず、`wrangler tail` を
	// 張っている間しか見えないため、500 の原因を事後に調べられない。
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "world-issue-tracker",
			"database_id": "546b760c-e10c-45cf-8c40-f3ec508e82fa"
		}
	],
	// Issue に添付する写真の置き場（#65）。
	//
	// バケットは `wrangler r2 bucket create world-issue-tracker-photos` で
	// 作成済み。画像の実体はここに置き、D1 の行にはキーだけを持つ
	// （理由は `migrations/0007_add_photo.sql`）。
	//
	// 公開バケットにはしていない。R2 のカスタムドメインを当てれば
	// 画像を直接配信できるが、そうすると Worker を通らない経路ができ、
	// 通報による非公開化（#65 の範囲外）を後から入れる余地が無くなる。
	// 配信は `GET /issues/:id/photo` が仲介する。
	//
	// `preview_bucket_name` は置いていない。`wrangler dev` / テストは
	// ローカルのシミュレーション（miniflare）で完結し、実バケットを触らない。
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "world-issue-tracker-photos"
		}
	],
	// 表明者・起票者・コメント投稿者の表示名（Clerk から引いた結果）のキャッシュ（#135）。
	//
	// 無認証で叩ける公開エンドポイント（`GET /issues/:id/help-offers`、`GET /issues`、
	// `GET /issues/:id`、`GET /issues/:id/comments`）が、表示名を引くために毎回
	// Clerk の管理 API を叩いていた。連打されるとその回数だけ Clerk への問い合わせが
	// 増幅し、レート制限を使い切ると認証（JWKS 取得）まで巻き添えになる。一度引いた
	// 表示名を User ID ごとにここへ載せ、次からは Clerk に触れないようにする
	// （`src/lib/display-names.ts`）。
	//
	// ⚠️ 下の `id` はプレースホルダ（実在しない namespace）。マージ前に必ず
	//   `wrangler kv namespace create world-issue-tracker-display-names`
	// で作成し、出力された ID に差し替えること。差し替えずにデプロイすると
	// `wrangler deploy`（.github/workflows/deploy.yml の deploy-api）が binding 検証で
	// 失敗し、後続の deploy-web まで含めてパイプラインが止まる。
	//
	// なおコード側はバインディングが無くても従来どおり動く（キャッシュが効かない
	// だけで公開エンドポイントは落ちない。Bindings で optional）。ただしそれは
	// バインディング宣言自体を消した場合の話で、宣言を残したまま id が無効だと
	// 上記のとおりデプロイが失敗する。
	//
	// `preview_id` は置いていない。`wrangler dev` / テストは miniflare の
	// ローカルシミュレーションで完結し、実 namespace を触らない（r2_buckets と同じ）。
	"kv_namespaces": [
		{
			"binding": "DISPLAY_NAME_CACHE",
			"id": "0000000000000000000000000000000000"
		}
	]
}
