# Clerk のキー https://dashboard.clerk.com/ の API Keys から取得する
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API サーバーの URL。ローカル開発では wrangler dev の既定ポート。
# NEXT_PUBLIC_ の値はビルド時にバンドルへ埋め込まれるため、
# デプロイ時にも同じ変数を渡す必要がある（.github/workflows/deploy.yml 参照）
NEXT_PUBLIC_API_URL=http://localhost:8787
